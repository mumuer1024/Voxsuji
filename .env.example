# media — local secrets. Copy this file to `.env` and fill in real values.
# `.env` is git-ignored. Never paste real keys into chat, issues or docs.
#
#   cp .env.example .env && chmod 600 .env && $EDITOR .env
#
# You only need to configure the provider(s) you actually use. An
# unconfigured provider does not affect the others.

# ---- Aliyun Bailian (DashScope) ------------------------------------------
# Required for `--provider aliyun`.
DASHSCOPE_API_KEY=
# Optional: override the API endpoint. The official default is used when unset:
# https://dashscope.aliyuncs.com/api/v1
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# ---- Volcengine recording-file ASR --------------------------------------
# Required only for `--provider volcengine`. Fill in ONE auth style:
#   (1) new console -> VOLC_API_KEY          (sent as `X-Api-Key`)
#   (2) legacy console -> VOLC_APP_ID + VOLC_ACCESS_TOKEN
#       (sent as `X-Api-App-Key` + `X-Api-Access-Key`)
VOLC_API_KEY=
VOLC_APP_ID=
VOLC_ACCESS_TOKEN=
# VOLC_RESOURCE_ID=volc.seedasr.auc
# VOLC_UID=                 # optional; sent as request.user.uid (default: media-tool)

# ---- Tencent Cloud ASR ----------------------------------------------------
# Required only for `--provider tencent`.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# TENCENT_REGION=ap-beijing
# TENCENT_TOKEN=            # only for temporary (STS) credentials

# ---- S3-compatible object storage (PUBLIC-read bucket) --------------------
# Used only to expose a temporary audio file to the ASR provider.
# The object is deleted immediately after transcription.
# These are example values — replace them with your own storage.
STORAGE_ENDPOINT=https://s3.example.com
STORAGE_REGION=example-region
STORAGE_BUCKET=your-bucket
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key
# Optional overrides:
# STORAGE_PATH_STYLE=false
# STORAGE_PUBLIC_BASE_URL=

# ---- Optional --------------------------------------------------------------
# YTDLP_PROXY=http://proxy.example.com:8080
# MEDIA_DATA_DIR=/path/to/data

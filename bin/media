#!/usr/bin/env bash
# media — thin launcher for the media_tool CLI.
#
# Bootstraps the project-local virtualenv on first use so nothing has to be
# installed system-wide.  No secrets are passed on the command line.
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="${PROJECT_ROOT}/.venv"
PYTHON="${VENV}/bin/python"

if [[ ! -x "${PYTHON}" ]]; then
  echo "media: creating virtualenv at ${VENV}" >&2
  python3 -m venv "${VENV}" >&2
  "${VENV}/bin/pip" install --quiet --upgrade pip >&2 || true
  "${VENV}/bin/pip" install --quiet yt-dlp >&2
fi

export PYTHONPATH="${PROJECT_ROOT}/src${PYTHONPATH:+:${PYTHONPATH}}"
exec "${PYTHON}" -m media_tool.cli "$@"
